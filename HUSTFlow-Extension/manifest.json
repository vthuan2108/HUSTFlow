{
  "manifest_version": 3,
  "name": "HUSTflow - Trận Pháp Chặn Tâm Ma & Trợ Thủ Studocu",
  "version": "2.0.0",
  "description": "Hộ Pháp: Bế quan thiền định ngăn chặn tâm ma xao nhãng & Gỡ mờ tải PDF trực tiếp trên Studocu.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*",
        "https://*.vercel.app/*",
        "<all_urls>"
      ],
      "js": ["content.js", "hustflow-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.studocu.com/*",
        "https://*.studocu.com/*",
        "https://www.studeersnel.nl/*",
        "https://*.studeersnel.nl/*",
        "https://www.studocu.vn/*",
        "https://*.studocu.vn/*"
      ],
      "js": [
        "update-inter.js",
        "view-doc.js",
        "remove-previewBanner.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
